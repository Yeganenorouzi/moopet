---
import Stars from './Stars.astro';
import { faNum, faDate } from '../../lib/format';
import { ratingSummary, type Review } from '../../lib/reviews';

interface Props {
  reviews: Review[];
  /** نام مرکز یا محله — در متن حالت خالی استفاده می‌شود */
  subject: string;
  /** شناسه‌ی مرکز برای ارسال نظر */
  listingId?: string;
}

const { reviews, subject, listingId } = Astro.props;

const approved = reviews.filter((r) => r.approved);
const summary = ratingSummary(reviews);
const maxCount = summary ? Math.max(...summary.dist.map((d) => d.count), 1) : 1;
---

<section aria-labelledby="reviews" class="mt-16 border-t border-ink-200 pt-12">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h2 id="reviews" class="text-2xl font-extrabold text-ink-900">دیدگاه کاربران</h2>
      <p class="mt-2 text-sm text-ink-600">
        {
          summary
            ? `${faNum(summary.count)} نظر ثبت‌شده`
            : 'اولین نفری باشید که تجربه‌اش را می‌نویسد'
        }
      </p>
    </div>

    <a
      href={listingId ? `/panel/review/?listing=${listingId}` : '/panel/review/'}
      class="rounded-pill bg-brand-700 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-800"
    >
      نوشتن دیدگاه
    </a>
  </div>

  {
    summary && (
      <div class="mt-8 grid gap-8 rounded-card border border-ink-200 bg-surface p-7 sm:grid-cols-[auto_1fr]">
        {/* میانگین */}
        <div class="text-center sm:border-l sm:border-ink-200 sm:pl-8">
          <p class="text-5xl font-extrabold text-ink-900">{faNum(summary.value)}</p>
          <div class="mt-2 flex justify-center">
            <Stars value={summary.value} size={18} />
          </div>
          <p class="mt-2 text-xs text-ink-500">از {faNum(summary.count)} نظر</p>
        </div>

        {/* توزیع ستاره‌ها */}
        <dl class="space-y-2">
          {summary.dist.map((d) => (
            <div class="flex items-center gap-3">
              <dt class="w-12 shrink-0 text-xs text-ink-600">{faNum(d.star)} ستاره</dt>
              <dd class="flex flex-1 items-center gap-3">
                <span class="h-2 flex-1 overflow-hidden rounded-pill bg-ink-100">
                  <span
                    class="block h-full rounded-pill bg-accent-500"
                    style={`width:${(d.count / maxCount) * 100}%`}
                  />
                </span>
                <span class="w-8 shrink-0 text-xs text-ink-500">{faNum(d.count)}</span>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    )
  }

  {
    approved.length > 0 ? (
      <ul class="mt-8 grid gap-4 md:grid-cols-2" data-anim="up" data-anim-stagger="0.3">
        {approved.map((r) => (
          <li class="rounded-card border border-ink-200 bg-surface p-6 shadow-soft">
            <div class="flex items-start justify-between gap-4">
              <div class="flex items-center gap-3">
                <span
                  class="grid size-10 shrink-0 place-items-center rounded-full bg-brand-100 font-bold text-brand-800"
                  aria-hidden="true"
                >
                  {r.author.trim().charAt(0)}
                </span>
                <div>
                  <p class="flex items-center gap-2 font-semibold text-ink-900">
                    {r.author}
                    {r.verified && (
                      <span class="rounded-pill bg-brand-50 px-2 py-0.5 text-[0.65rem] font-bold text-brand-700">
                        مراجعه تأییدشده
                      </span>
                    )}
                  </p>
                  <time
                    datetime={r.createdAt.toISOString()}
                    class="text-xs text-ink-500"
                  >
                    {faDate(r.createdAt)}
                  </time>
                </div>
              </div>
              <Stars value={r.rating} size={14} />
            </div>

            <p class="mt-4 leading-8 text-ink-700">{r.body}</p>
          </li>
        ))}
      </ul>
    ) : (
      /* حالت خالی — صادقانه. هیچ نظر نمونه‌ای ساخته نمی‌شود:
         AggregateRating جعلی پنالتی دستی گوگل دارد. */
      <div class="mt-8 rounded-card border border-dashed border-ink-300 bg-surface p-10 text-center">
        <span class="inline-grid size-14 place-items-center rounded-full bg-accent-100 text-accent-700">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9 9 0 0 1-3.3-.6L3 21l1.7-5a8.2 8.2 0 0 1-.7-3.4 8.4 8.4 0 0 1 8.5-8.4 8.4 8.4 0 0 1 8.5 8.3Z" />
          </svg>
        </span>

        <p class="mt-4 font-bold text-ink-800">هنوز دیدگاهی درباره‌ی {subject} ثبت نشده</p>
        <p class="mx-auto mt-2 max-w-md text-sm leading-8 text-ink-600">
          اگر تجربه‌ی مراجعه دارید، بنویسید. نظر شما به صاحبان حیوانات دیگر کمک
          می‌کند انتخاب بهتری داشته باشند.
        </p>

        <a
          href={listingId ? `/panel/review/?listing=${listingId}` : '/panel/review/'}
          class="mt-6 inline-block rounded-pill bg-brand-700 px-6 py-3 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 hover:bg-brand-800"
        >
          نوشتن اولین دیدگاه
        </a>
      </div>
    )
  }

  <p class="mt-6 text-xs leading-7 text-ink-500">
    دیدگاه‌ها پیش از انتشار توسط کارشناسان موپت بررسی می‌شوند. نظرهای تبلیغاتی و
    توهین‌آمیز منتشر نمی‌شوند.
  </p>
</section>
