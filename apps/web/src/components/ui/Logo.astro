---
import { SITE } from '../../lib/site';

interface Props {
  href?: string;
}
const { href = '/' } = Astro.props;
---

<a
  href={href}
  class="flex shrink-0 items-center gap-2 text-xl font-extrabold text-brand-800"
  aria-label={`${SITE.name} — صفحه اصلی`}
>
  <span
    class="grid size-9 place-items-center rounded-xl bg-brand-700 text-white shadow-soft"
    aria-hidden="true"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
      <ellipse cx="8" cy="7.5" rx="2.1" ry="2.8"></ellipse>
      <ellipse cx="16" cy="7.5" rx="2.1" ry="2.8"></ellipse>
      <ellipse cx="4.3" cy="13" rx="1.9" ry="2.4"></ellipse>
      <ellipse cx="19.7" cy="13" rx="1.9" ry="2.4"></ellipse>
      <path
        d="M12 12.2c2.9 0 5.3 2.3 5.3 4.7 0 1.9-1.4 3-3.3 3-.9 0-1.4-.3-2-.3s-1.1.3-2 .3c-1.9 0-3.3-1.1-3.3-3 0-2.4 2.4-4.7 5.3-4.7Z"
      ></path>
    </svg>
  </span>
  {SITE.name}
</a>
