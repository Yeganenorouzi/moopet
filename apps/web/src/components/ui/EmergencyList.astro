---
import type { Listing } from '../../lib/listings';
import { formatPhone, telHref } from '../../lib/phone';
import { url } from '../../lib/taxonomy';
import { getNeighborhood } from '../../lib/taxonomy';
import { faNum } from '../../lib/format';

interface Props {
  listings: Listing[];
  areaFa: string;
}
const { listings, areaFa } = Astro.props;

/**
 * لیست اورژانسی — طراحی عمداً با بقیه‌ی سایت فرق دارد.
 *
 * کاربر این صفحه ساعت ۲ بامداد با حیوان بیمار پشت خط است. پس:
 *  - شماره تلفن بزرگ‌ترین عنصر کارت است، نه نام مرکز
 *  - دکمه‌ی تماس در موبایل تمام‌عرض و قابل لمس با شست
 *  - هیچ انیمیشن ورودی‌ای وجود ندارد؛ محتوا باید فوراً آنجا باشد
 *  - مراکز دارای تلفن همیشه اول می‌آیند
 */
const withPhone = listings.filter((l) => l.phone);
const withoutPhone = listings.filter((l) => !l.phone);
---

{
  listings.length > 0 ? (
    <>
      <p class="mb-5 text-sm text-ink-600">
        {faNum(listings.length)} مرکز شبانه‌روزی در {areaFa}
        {withPhone.length > 0 && ` — ${faNum(withPhone.length)} مورد با شماره تماس`}
      </p>

      <ul class="space-y-3">
        {[...withPhone, ...withoutPhone].map((l) => {
          const hood = l.neighborhood ? getNeighborhood(l.neighborhood) : null;
          return (
            <li class="overflow-hidden rounded-card border-2 border-ink-200 bg-surface transition-colors hover:border-accent-400">
              <div class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center">
                <div class="min-w-0 flex-1">
                  <h3 class="font-bold text-ink-900">
                    <a href={url.clinic(l.city, l.slug)} class="hover:text-brand-700">
                      {l.name}
                    </a>
                  </h3>

                  <p class="mt-1.5 text-sm text-ink-600">
                    {hood ? `${hood.fa} — ` : ''}
                    {l.address}
                  </p>

                  <span class="mt-2.5 inline-flex items-center gap-1.5 rounded-pill bg-brand-50 px-2.5 py-1 text-xs font-bold text-brand-700">
                    <span class="size-1.5 rounded-full bg-brand-500" aria-hidden="true" />
                    همین حالا باز است
                  </span>
                </div>

                {/* تماس — بزرگ‌ترین عنصر کارت */}
                {l.phone ? (
                  <a
                    href={telHref(l.phone)}
                    class="flex shrink-0 items-center justify-center gap-2 rounded-pill bg-accent-600 px-7 py-4 text-lg font-extrabold text-white shadow-lift transition-colors hover:bg-accent-700 sm:py-3.5"
                  >
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .5 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.5-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.3 2.2Z" />
                    </svg>
                    <span dir="ltr">{formatPhone(l.phone)}</span>
                  </a>
                ) : (
                  <a
                    href={url.clinic(l.city, l.slug)}
                    class="shrink-0 rounded-pill border-2 border-ink-300 px-6 py-3.5 text-center text-sm font-bold text-ink-600 transition-colors hover:border-brand-400 hover:text-brand-700"
                  >
                    آدرس و مسیر
                  </a>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    </>
  ) : (
    <div class="rounded-card border-2 border-dashed border-ink-300 bg-surface p-10 text-center">
      <p class="font-bold text-ink-800">مرکز شبانه‌روزی در {areaFa} ثبت نشده است</p>
      <p class="mx-auto mt-3 max-w-md text-sm leading-8 text-ink-600">
        مراکز شبانه‌روزی نزدیک‌تر را در صفحه‌ی کل تهران ببینید.
      </p>
      <a
        href={url.categoryCity('vet-24h', 'tehran')}
        class="mt-5 inline-block rounded-pill bg-accent-600 px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-accent-700"
      >
        دامپزشکی شبانه‌روزی تهران
      </a>
    </div>
  )
}
