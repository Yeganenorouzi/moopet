---
/**
 * ایلاستریشن هیرو — نقشه‌ی انتزاعی با پین مراکز.
 *
 * inline SVG است نه فایل تصویر، چون:
 *  ۱. یک درخواست شبکه کمتر پیش از LCP
 *  ۲. با توکن‌های رنگ برند هماهنگ می‌ماند
 *  ۳. در هر رزولوشنی تیز است
 *
 * ⚠️ این المان در ناحیه‌ی LCP است و هیچ انیمیشن ورودی ندارد.
 */
---

<svg
  viewBox="0 0 520 440"
  class="h-auto w-full"
  role="img"
  aria-label="نقشه‌ی تهران با نشانگر مراکز خدمات حیوانات خانگی"
>
  <defs>
    <linearGradient id="mapBg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="oklch(97% 0.02 165)" />
      <stop offset="100%" stop-color="oklch(93% 0.04 165)" />
    </linearGradient>
    <linearGradient id="pinG" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="oklch(60% 0.11 163)" />
      <stop offset="100%" stop-color="oklch(43% 0.08 163)" />
    </linearGradient>
    <filter id="cardShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="oklch(30% 0.02 85)" flood-opacity="0.12" />
    </filter>
  </defs>

  <!-- بدنه‌ی نقشه -->
  <rect x="24" y="28" width="472" height="384" rx="28" fill="url(#mapBg)" />

  <!-- خیابان‌ها -->
  <g stroke="oklch(88% 0.03 165)" stroke-width="7" stroke-linecap="round" fill="none">
    <path d="M24 150 H496" />
    <path d="M24 268 H496" />
    <path d="M160 28 V412" />
    <path d="M330 28 V412" />
  </g>
  <g stroke="oklch(91% 0.02 165)" stroke-width="3" stroke-linecap="round" fill="none">
    <path d="M24 92 H496" />
    <path d="M24 205 H496" />
    <path d="M24 342 H496" />
    <path d="M90 28 V412" />
    <path d="M245 28 V412" />
    <path d="M415 28 V412" />
  </g>

  <!-- بلوک‌های سبز (پارک) -->
  <rect x="345" y="290" width="62" height="40" rx="10" fill="oklch(89% 0.06 150)" />
  <rect x="103" y="106" width="44" height="32" rx="9" fill="oklch(89% 0.06 150)" />

  <!-- رودخانه/بزرگراه مورب -->
  <path
    d="M24 400 C 140 360, 200 300, 300 250 S 450 140, 496 60"
    stroke="oklch(90% 0.045 220)"
    stroke-width="10"
    fill="none"
    stroke-linecap="round"
    opacity="0.65"
  />

  <!-- پین‌های فرعی -->
  <g fill="oklch(71% 0.158 42)">
    <circle cx="120" cy="330" r="9" />
    <circle cx="395" cy="120" r="9" />
    <circle cx="270" cy="360" r="7" opacity="0.75" />
    <circle cx="450" cy="245" r="7" opacity="0.75" />
    <circle cx="70" cy="200" r="7" opacity="0.6" />
  </g>

  <!-- پین اصلی -->
  <g transform="translate(200 120)">
    <ellipse cx="30" cy="104" rx="20" ry="6" fill="oklch(30% 0.02 85)" opacity="0.13" />
    <path
      d="M30 0C13.4 0 0 13.4 0 30c0 21 24 60 28.1 66.4a2.3 2.3 0 0 0 3.8 0C36 90 60 51 60 30 60 13.4 46.6 0 30 0Z"
      fill="url(#pinG)"
    />
    <circle cx="30" cy="30" r="14" fill="#fff" />
    <!-- پنجه داخل پین -->
    <g fill="oklch(43% 0.08 163)" transform="translate(21 21) scale(0.75)">
      <ellipse cx="8" cy="7.5" rx="2.1" ry="2.8" />
      <ellipse cx="16" cy="7.5" rx="2.1" ry="2.8" />
      <ellipse cx="4.3" cy="13" rx="1.9" ry="2.4" />
      <ellipse cx="19.7" cy="13" rx="1.9" ry="2.4" />
      <path d="M12 12.2c2.9 0 5.3 2.3 5.3 4.7 0 1.9-1.4 3-3.3 3-.9 0-1.4-.3-2-.3s-1.1.3-2 .3c-1.9 0-3.3-1.1-3.3-3 0-2.4 2.4-4.7 5.3-4.7Z" />
    </g>
  </g>

  <!-- کارت شناور: مرکز نمونه -->
  <g filter="url(#cardShadow)">
    <rect x="286" y="296" width="196" height="76" rx="16" fill="#fff" />
    <rect x="446" y="312" width="22" height="22" rx="7" fill="oklch(94.5% 0.042 163)" />
    <circle cx="457" cy="323" r="5" fill="oklch(43% 0.08 163)" />
    <rect x="306" y="315" width="126" height="9" rx="4.5" fill="oklch(86% 0.009 85)" />
    <rect x="336" y="334" width="96" height="7" rx="3.5" fill="oklch(92% 0.008 85)" />
    <rect x="374" y="349" width="58" height="7" rx="3.5" fill="oklch(89% 0.082 53)" />
  </g>

  <!-- کارت شناور: باز است -->
  <g filter="url(#cardShadow)">
    <rect x="52" y="58" width="150" height="54" rx="14" fill="#fff" />
    <circle cx="178" cy="85" r="10" fill="oklch(89% 0.06 150)" />
    <path d="M174 85l3 3 5.5-5.5" stroke="oklch(42% 0.09 150)" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
    <rect x="72" y="74" width="86" height="8" rx="4" fill="oklch(86% 0.009 85)" />
    <rect x="102" y="90" width="56" height="6" rx="3" fill="oklch(92% 0.008 85)" />
  </g>
</svg>
