---
interface Props {
  id: string;
  title: string;
  subtitle?: string;
  /** وسط‌چین برای بخش‌های تبلیغاتی؛ پیش‌فرض تراز از ابتدای خط (راست در RTL) */
  center?: boolean;
}

const { id, title, subtitle, center = false } = Astro.props;
---

<div class={center ? 'text-center' : ''} data-anim="up">
  <h2 id={id} class="text-2xl font-extrabold text-ink-900 sm:text-3xl">
    {title}
  </h2>
  {
    subtitle && (
      <p class={`mt-3 text-ink-600 ${center ? 'mx-auto max-w-2xl' : 'max-w-2xl'}`}>
        {subtitle}
      </p>
    )
  }
  <span class="mt-5 block h-1 w-14 rounded-pill bg-accent-500" aria-hidden="true"></span>
</div>
