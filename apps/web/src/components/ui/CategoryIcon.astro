  'pet-shop': 'M5 8h14l-1 12H6L5 8Z M9 8V6a3 3 0 0 1 6 0v2',
  'pet-grooming': 'M6 4v9a3 3 0 0 0 6 0V4 M18 4v7 M18 13v7 M9 16v4',
  'pet-boarding': 'M4 11 12 4l8 7v9H4v-9Z M10 20v-5h4v5',
  'dog-training': 'M4 18h10a4 4 0 0 0 0-8H9 M9 6l-3 4 3 4 M18 15l3 3-3 3',
  'vet-pharmacy': 'M12 6v12 M6 12h12 M5 5h14v14H5Z',
