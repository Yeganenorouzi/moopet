 * inline است نه فایل، چون آیکون‌ها کوچک‌اند و یک درخواست شبکه‌ی اضافه
 * برای هرکدام به LCP ضربه می‌زند.
 */
interface Props {
  slug: string;
  size?: number;
}
const { slug, size = 22 } = Astro.props;

const paths: Record<string, string> = {
  vet: 'M12 21s-7-4.6-7-9.6A4.4 4.4 0 0 1 12 8a4.4 4.4 0 0 1 7 3.4c0 5-7 9.6-7 9.6Z M12 11v4 M10 13h4',
