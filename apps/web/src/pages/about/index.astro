---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import PageHero from '../../components/ui/PageHero.astro';
import { categories, neighborhoods, zones } from '../../lib/taxonomy';
import content from '../../data/content.json';

const values = content.about.values;

const stats = [
  { v: categories.length, l: 'دسته خدمات' },
  { v: zones.length, l: 'منطقه‌ی تهران' },
  { v: neighborhoods.length, l: 'محله' },
];
---

<Base
  title={content.about.title}
  description="موپت بانک اطلاعات خدمات حیوانات خانگی در تهران است. هدف ما این است که پیدا کردن دامپزشک، پت شاپ و آرایشگاه حیوانات در محله‌ی خودتان ساده شود."
>
  <PageHero
    title={content.about.title}
    subtitle={content.about.subtitle}
  >
    <Breadcrumbs
      items={[
        { name: 'موپت', href: '/' },
        { name: 'درباره ما', href: '/about/' },
      ]}
    />
  </PageHero>

  <div class="container-page py-16">
    <div class="mx-auto max-w-3xl">
      <div class="space-y-5 leading-9 text-ink-600">
        {content.about.story.map((t) => <p>{t}</p>)}
      </div>

      <dl class="mt-12 grid grid-cols-3 gap-4" data-anim="up" data-anim-stagger="0.25">
        {
          stats.map((s) => (
            <div class="rounded-card border border-ink-200 bg-surface p-6 text-center shadow-soft">
              <dt class="sr-only">{s.l}</dt>
              <dd>
                <span class="block text-3xl font-extrabold text-brand-700">
                  {s.v}
                </span>
                <span class="mt-1 block text-sm text-ink-500">{s.l}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <section aria-labelledby="values" class="border-y border-ink-200 bg-surface-sunken">
    <div class="container-page py-16">
      <div class="mx-auto max-w-3xl">
        <SectionHead id="values" title={content.about.valuesTitle} />
        <div class="mt-10 grid gap-5 sm:grid-cols-2" data-anim="up" data-anim-stagger="0.25">
          {
            values.map((v) => (
              <div class="rounded-card border border-ink-200 bg-surface p-7 shadow-soft">
                <h3 class="font-bold text-ink-900">{v.t}</h3>
                <p class="mt-3 text-sm leading-8 text-ink-600">{v.d}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="container-page py-16">
    <div
      class="mx-auto max-w-3xl rounded-card bg-brand-800 px-8 py-12 text-center"
      data-anim="scale"
    >
      <h2 class="text-2xl font-extrabold text-white">{content.about.ctaTitle}</h2>
      <p class="mx-auto mt-3 max-w-lg text-brand-100">
        {content.about.ctaText}
      </p>
      <a
        href="/panel/register-business/"
        class="mt-7 inline-block rounded-pill bg-accent-500 px-7 py-3 font-bold text-accent-950 transition-all hover:-translate-y-0.5 hover:bg-accent-400"
      >
        ثبت رایگان
      </a>
    </div>
  </section>
</Base>
